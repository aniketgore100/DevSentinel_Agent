# Port the gateway listens on.
PORT=3000

# Required. Shared secret configured on the GitHub webhook (Settings → Webhooks → Secret).
# Used to verify X-Hub-Signature-256 on every incoming request.
GITHUB_WEBHOOK_SECRET=

# Upstash Redis REST credentials. Leave both blank to run in DRY-RUN mode:
# jobs are logged instead of queued, and idempotency/rate-limit checks are skipped.
# Day 2 needs only these two vars filled in — no code changes.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Max processed webhooks per repo per hour before returning 429.
RATE_LIMIT_PER_HOUR=30

# How long a `seen:{repo}:{pr}:{head_sha}` idempotency key lives, in seconds.
IDEMPOTENCY_TTL_SECONDS=600

# Redis list the gateway LPUSHes normalised jobs onto.
QUEUE_KEY=pr_review_queue
