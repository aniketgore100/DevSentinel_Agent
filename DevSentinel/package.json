{
  "name": "devsentinel-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "DevSentinel AI ingestion gateway — verifies GitHub PR webhooks and enqueues review jobs",
  "type": "commonjs",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.3",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "helmet": "^7.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.15",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
